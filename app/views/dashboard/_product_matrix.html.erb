<%
  vb_w = 960
  vb_h = 440
  pad_l = 52
  pad_r = 28
  pad_t = 30
  pad_b = 46
  x_min, x_max = -20.0, 22.0
  x = ->(delta) { pad_l + (delta - x_min) / (x_max - x_min) * (vb_w - pad_l - pad_r) }
  y = ->(vis) { pad_t + (1 - vis / 100.0) * (vb_h - pad_t - pad_b) }
  revs = products.map(&:monthly_revenue_cents)
  r_scale = ->(rev) { 7 + (Math.sqrt(rev) - Math.sqrt(revs.min)) / (Math.sqrt(revs.max) - Math.sqrt(revs.min)) * 15 }
  labelled = products.sort_by { |p| -p.monthly_revenue_cents }.first(8)
  short = ->(p) { p.name.sub(/\A(NordPeak|LumenRide|TrailForge|GripWorks|AlpenGlow|Cadenza|Veloce) /, "") }
%>
<div class="mt-6 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-950/5">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div>
      <h2 class="text-base font-semibold"><%= dt("Product portfolio matrix") %></h2>
      <p class="mt-0.5 text-xs text-gray-400"><%= dt("Every product by price position and visibility. Bubble size is revenue per 30 days; colour is the sales trend.") %></p>
    </div>
    <div class="flex items-center gap-x-5 text-xs text-gray-500">
      <span class="inline-flex items-center gap-x-1.5"><span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span><%= dt("Sales growing") %></span>
      <span class="inline-flex items-center gap-x-1.5"><span class="h-2.5 w-2.5 rounded-full bg-rose-500"></span><%= dt("Sales declining") %></span>
      <%= link_to dt("Full price table →"), price_position_path, class: "font-medium text-accent-600 hover:text-accent-700" %>
    </div>
  </div>

  <div id="matrix-chart" class="relative mt-4">
    <svg viewBox="0 0 <%= vb_w %> <%= vb_h %>" class="w-full" style="height:auto" role="img" aria-label="<%= dt("Product matrix: price position versus visibility, bubble size is monthly revenue") %>">
      <!-- Y ticks -->
      <% [0, 25, 50, 75, 100].each do |tick| %>
        <line x1="<%= pad_l %>" x2="<%= vb_w - pad_r %>" y1="<%= y.(tick).round(1) %>" y2="<%= y.(tick).round(1) %>" stroke="#f3f4f6" stroke-width="1" />
        <text x="<%= pad_l - 8 %>" y="<%= (y.(tick) + 3).round(1) %>" text-anchor="end" class="fill-gray-400" font-size="10"><%= tick %></text>
      <% end %>
      <!-- X ticks -->
      <% [-20, -10, 0, 10, 20].each do |tick| %>
        <text x="<%= x.(tick).round(1) %>" y="<%= vb_h - 26 %>" text-anchor="middle" class="fill-gray-400" font-size="10"><%= tick.zero? ? dt("parity") : signed_pct(tick) %></text>
      <% end %>
      <!-- Quadrant midlines -->
      <line x1="<%= x.(0).round(1) %>" x2="<%= x.(0).round(1) %>" y1="<%= pad_t %>" y2="<%= vb_h - pad_b %>" stroke="#d1d5db" stroke-width="1" />
      <line x1="<%= pad_l %>" x2="<%= vb_w - pad_r %>" y1="<%= y.(50).round(1) %>" y2="<%= y.(50).round(1) %>" stroke="#d1d5db" stroke-width="1" />
      <!-- Quadrant labels -->
      <text x="<%= pad_l + 8 %>" y="<%= pad_t + 14 %>" class="fill-gray-300" font-size="10" font-weight="600"><%= dt("CHEAPER & VISIBLE · WINNERS") %></text>
      <text x="<%= vb_w - pad_r - 8 %>" y="<%= pad_t + 14 %>" text-anchor="end" class="fill-gray-300" font-size="10" font-weight="600"><%= dt("PREMIUM & VISIBLE · DEFEND") %></text>
      <text x="<%= pad_l + 8 %>" y="<%= vb_h - pad_b - 8 %>" class="fill-gray-300" font-size="10" font-weight="600"><%= dt("CHEAPER & INVISIBLE · PROMOTE") %></text>
      <text x="<%= vb_w - pad_r - 8 %>" y="<%= vb_h - pad_b - 8 %>" text-anchor="end" class="fill-gray-300" font-size="10" font-weight="600"><%= dt("PREMIUM & INVISIBLE · FIX OR EXIT") %></text>
      <!-- Axis titles -->
      <text x="<%= pad_l %>" y="14" class="fill-gray-400" font-size="10"><%= dt("Visibility (share of voice)") %></text>
      <text x="<%= pad_l %>" y="<%= vb_h - 8 %>" class="fill-gray-400" font-size="10"><%= dt("← cheaper than market") %></text>
      <text x="<%= vb_w - pad_r %>" y="<%= vb_h - 8 %>" text-anchor="end" class="fill-gray-400" font-size="10"><%= dt("more expensive →") %></text>

      <!-- Bubbles, then labels on top, then hover hit areas -->
      <%
        geometry = products.map do |product|
          [product,
           x.(product.market_min_delta_pct.to_f).round(1),
           y.(product.visibility_score).round(1),
           r_scale.(product.monthly_revenue_cents).round(1)]
        end
      %>
      <% geometry.each do |product, cx, cy, r| %>
        <circle cx="<%= cx %>" cy="<%= cy %>" r="<%= r %>" fill="<%= product.trend_pct >= 0 ? '#10b981' : '#f43f5e' %>" fill-opacity="0.8" stroke="#ffffff" stroke-width="2" />
      <% end %>
      <% geometry.each do |product, cx, cy, r| %>
        <% next unless labelled.include?(product) %>
        <text x="<%= cx %>" y="<%= (cy - r - 5) %>" text-anchor="middle" class="fill-gray-600" font-size="10" font-weight="600" stroke="#ffffff" stroke-width="3" paint-order="stroke"><%= short.(product) %></text>
      <% end %>
      <% geometry.each do |product, cx, cy, r| %>
        <circle cx="<%= cx %>" cy="<%= cy %>" r="<%= [r + 6, 18].max %>" fill="transparent" data-role="dot"
                data-name="<%= product.name %>"
                data-price="<%= product.market_min_delta_pct <= 0 ? dt("%{pct} vs market min (cheapest)", pct: signed_pct(product.market_min_delta_pct)) : dt("%{pct} vs market min", pct: signed_pct(product.market_min_delta_pct)) %>"
                data-vis="<%= dt("Visibility %{v} / 100", v: product.visibility_score) %>"
                data-trend="<%= product.trend_pct >= 0 ? dt("Sales growing %{pct}", pct: signed_pct(product.trend_pct)) : dt("Sales declining %{pct}", pct: signed_pct(product.trend_pct)) %>"
                data-revenue="<%= dt("%{eur} / 30 days", eur: euro(product.monthly_revenue_cents)) %>" />
      <% end %>
    </svg>
    <div data-role="tooltip" class="pointer-events-none absolute z-10 hidden min-w-48 rounded-lg bg-gray-950 px-3 py-2 text-xs text-white shadow-lg"></div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById("matrix-chart");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "1";
    var svg = root.querySelector("svg");
    var tooltip = root.querySelector('[data-role="tooltip"]');

    root.querySelectorAll('[data-role="dot"]').forEach(function (dot) {
      dot.addEventListener("pointerenter", function () {
        tooltip.textContent = "";
        var head = document.createElement("div");
        head.className = "mb-1 font-semibold";
        head.textContent = dot.dataset.name;
        tooltip.appendChild(head);
        ["price", "vis", "trend", "revenue"].forEach(function (key) {
          var line = document.createElement("div");
          line.className = "py-0.5 text-gray-300";
          line.textContent = dot.dataset[key];
          tooltip.appendChild(line);
        });
        var rect = svg.getBoundingClientRect();
        var scale = rect.width / <%= vb_w %>;
        var px = dot.cx.baseVal.value * scale;
        var py = dot.cy.baseVal.value * rect.height / <%= vb_h %>;
        var flip = px > rect.width * 0.66;
        tooltip.style.left = flip ? "" : (px + 18) + "px";
        tooltip.style.right = flip ? (rect.width - px + 18) + "px" : "";
        tooltip.style.top = Math.max(py - 30, 4) + "px";
        tooltip.classList.remove("hidden");
      });
      dot.addEventListener("pointerleave", function () {
        tooltip.classList.add("hidden");
      });
    });
  })();
</script>
