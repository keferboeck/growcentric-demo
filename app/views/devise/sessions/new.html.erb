<% content_for :title, dt("Sign in") %>

<div class="mx-auto w-full max-w-md">
  <div class="flex flex-col items-center">
    <%= render "shared/mark", css: "h-14 w-14", suffix: "-auth" %>
    <h1 class="mt-6 text-2xl font-semibold tracking-tight"><%= dt("Sign in to GrowCentric") %></h1>
    <p class="mt-2 text-sm text-gray-500"><%= dt("Welcome back. Your shop has been busy.") %></p>
  </div>

  <div class="mt-8 rounded-2xl bg-white p-8 shadow-sm ring-1 ring-gray-950/5">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
      <div>
        <%= f.label :email, dt("Email"), class: "block text-sm font-medium text-gray-700" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "mt-1.5 w-full rounded-lg border-0 bg-gray-50 px-3 py-2 text-sm ring-1 ring-inset ring-gray-200 focus:ring-2 focus:ring-accent-400" %>
      </div>
      <div>
        <div class="flex items-center justify-between">
          <%= f.label :password, dt("Password"), class: "block text-sm font-medium text-gray-700" %>
          <%= link_to dt("Forgot password?"), forgot_password_path, class: "text-sm font-medium text-accent-600 hover:text-accent-700" %>
        </div>
        <%= f.password_field :password, autocomplete: "current-password",
              class: "mt-1.5 w-full rounded-lg border-0 bg-gray-50 px-3 py-2 text-sm ring-1 ring-inset ring-gray-200 focus:ring-2 focus:ring-accent-400" %>
      </div>
      <div class="flex items-center gap-x-2.5">
        <%= f.check_box :remember_me, checked: true, class: "h-4 w-4 rounded border-gray-300 text-accent-600 focus:ring-accent-400" %>
        <%= f.label :remember_me, dt("Keep me signed in"), class: "text-sm text-gray-600" %>
      </div>
      <%= f.submit dt("Sign in"), class: "w-full cursor-pointer rounded-full bg-gray-950 px-4 py-2.5 text-sm font-semibold text-white hover:bg-gray-800" %>
    <% end %>
  </div>

  <p class="mt-6 text-center text-sm text-gray-500">
    <%= dt("New to GrowCentric?") %>
    <%= link_to dt("Request access"), register_path, class: "font-medium text-accent-600 hover:text-accent-700" %>
  </p>
</div>
