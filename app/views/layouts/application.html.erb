<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full bg-gray-50">
  <head>
    <%= render "shared/seo" %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full text-gray-950 antialiased">
    <div>
      <!-- Static sidebar for desktop -->
      <div class="hidden lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-72 lg:flex-col">
        <div class="flex grow flex-col gap-y-5 overflow-y-auto border-r border-gray-200 bg-white px-6 pb-4">
          <div class="flex h-16 shrink-0 items-center gap-x-3">
            <%= render "shared/mark", css: "h-8 w-8", suffix: "-side" %>
            <span class="text-lg font-semibold tracking-tight">GrowCentric</span>
          </div>
          <nav class="flex flex-1 flex-col">
            <ul role="list" class="flex flex-1 flex-col gap-y-7">
              <li>
                <ul role="list" class="-mx-2 space-y-1">
                  <%= render "shared/nav_item", path: root_path, label: dt("Dashboard"), icon: :home %>
                  <li>
                    <% sherpa_active = current_page?(sherpa_path) %>
                    <%= link_to sherpa_path,
                        class: "group flex items-center gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 #{sherpa_active ? 'bg-accent-50 text-accent-700' : 'text-gray-700 hover:bg-gray-50 hover:text-accent-700'}" do %>
                      <svg class="h-6 w-6 shrink-0 <%= sherpa_active ? 'text-accent-600' : 'text-gray-400 group-hover:text-accent-600' %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z" />
                      </svg>
                      Sherpa
                      <span class="ml-auto inline-flex items-center rounded-full bg-brand-gradient px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-gray-950">Beta</span>
                    <% end %>
                  </li>
                </ul>
              </li>
              <li>
                <div class="text-xs font-semibold leading-6 text-gray-400"><%= dt("Analyze") %></div>
                <ul role="list" class="-mx-2 mt-2 space-y-1">
                  <%= render "shared/nav_item", path: products_path, label: dt("Hidden potential"), icon: :sparkles %>
                  <%= render "shared/nav_item", path: competitors_path, label: dt("Competitors"), icon: :flag %>
                  <%= render "shared/nav_item", path: price_position_path, label: dt("Price position"), icon: :tag %>
                  <%= render "shared/nav_item", path: delivery_path, label: dt("Delivery & offers"), icon: :truck %>
                  <%= render "shared/nav_item", path: forecast_path, label: dt("Forecast"), icon: :chart %>
                </ul>
              </li>
              <li>
                <div class="text-xs font-semibold leading-6 text-gray-400"><%= dt("Act") %></div>
                <ul role="list" class="-mx-2 mt-2 space-y-1">
                  <%= render "shared/nav_item", path: campaigns_path, label: dt("Campaigns"), icon: :megaphone %>
                  <%= render "shared/nav_item", path: dynamic_pricing_path, label: dt("Dynamic pricing"), icon: :cpu %>
                  <%= render "shared/nav_item", path: recommendations_path, label: dt("Recommendations"), icon: :bolt %>
                </ul>
              </li>
              <li>
                <div class="text-xs font-semibold leading-6 text-gray-400"><%= dt("Content AI") %></div>
                <ul role="list" class="-mx-2 mt-2 space-y-1">
                  <%= render "shared/nav_item", path: content_path, label: dt("Catalog content"), icon: :doc %>
                  <%= render "shared/nav_item", path: content_queue_path, label: dt("Queue & approvals"), icon: :inbox %>
                  <%= render "shared/nav_item", path: content_experiments_path, label: dt("Experiments"), icon: :beaker %>
                </ul>
              </li>
              <li>
                <div class="text-xs font-semibold leading-6 text-gray-400"><%= dt("Manufacturer mode") %></div>
                <ul role="list" class="-mx-2 mt-2 space-y-1">
                  <%= render "shared/nav_item", path: resellers_path, label: dt("Resellers"), icon: :building %>
                </ul>
              </li>
              <li>
                <ul role="list" class="-mx-2 space-y-1">
                  <%= render "shared/nav_item", path: settings_section_path("automation"), label: dt("Settings"), icon: :gear %>
                </ul>
              </li>
              <li>
                <div class="text-xs font-semibold leading-6 text-gray-400"><%= dt("Help") %></div>
                <ul role="list" class="-mx-2 mt-2 space-y-1">
                  <li>
                    <a href="https://docs.growcentric.ai" target="_blank" rel="noopener"
                       class="group flex items-center gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 text-gray-700 hover:bg-gray-50 hover:text-accent-700">
                      <svg class="h-6 w-6 shrink-0 text-gray-400 group-hover:text-accent-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                      </svg>
                      <%= dt("Manual") %>
                      <svg class="ml-auto h-4 w-4 text-gray-300 group-hover:text-accent-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
                    </a>
                  </li>
                  <li>
                    <a href="https://growcentric.ai/slack" target="_blank" rel="noopener"
                       class="group flex items-center gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 text-gray-700 hover:bg-gray-50 hover:text-accent-700">
                      <svg class="h-6 w-6 shrink-0 p-0.5 text-gray-400 group-hover:text-accent-600" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zm1.271 0a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zm0 1.271a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zm10.122 2.521a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zm-1.268 0a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zm-2.523 10.122a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zm0-1.268a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z" />
                      </svg>
                      <%= dt("Join Slack") %>
                      <svg class="ml-auto h-4 w-4 text-gray-300 group-hover:text-accent-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
                    </a>
                  </li>
                </ul>
              </li>
              <li class="mt-auto -mx-2">
                <div class="rounded-xl bg-gray-50 p-4 ring-1 ring-inset ring-gray-200">
                  <div class="flex items-center gap-x-3">
                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-gradient text-sm font-semibold text-gray-950">V</div>
                    <div class="min-w-0">
                      <p class="truncate text-sm font-semibold">Velora Cycling Supply</p>
                      <p class="text-xs text-gray-500">Solidus · velora.keferboeck.com</p>
                    </div>
                  </div>
                  <p class="mt-3 text-xs leading-5 text-gray-500"><%= dt("Crawler healthy · last sync 14 min ago") %></p>
                </div>
              </li>
            </ul>
          </nav>
        </div>
      </div>

      <div class="lg:pl-72">
        <!-- Top bar -->
        <div class="sticky top-0 z-40 flex h-16 shrink-0 items-center gap-x-4 border-b border-gray-200 bg-white/80 px-4 backdrop-blur sm:gap-x-6 sm:px-6 lg:px-8">
          <div class="flex items-center gap-x-3 lg:hidden">
            <%= render "shared/mark", css: "h-7 w-7", suffix: "-top" %>
            <span class="font-semibold">GrowCentric</span>
          </div>
          <%= render "shared/shop_status" %>
          <div class="flex flex-1 items-center justify-end gap-x-4 self-stretch lg:gap-x-6">
            <%= render "shared/date_range" %>
            <button type="button" class="relative rounded-full p-1.5 text-gray-400 hover:text-gray-500">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" /></svg>
              <span class="absolute right-1 top-1 h-2 w-2 rounded-full bg-brand-pink ring-2 ring-white"></span>
            </button>
            <div class="hidden lg:block lg:h-6 lg:w-px lg:bg-gray-200"></div>
            <%= render "shared/locale_switcher" %>
            <%= render "shared/user_menu" %>
          </div>
        </div>

        <main class="py-8">
          <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <%= render "shared/flash" %>
            <%= yield %>
          </div>
        </main>
      </div>
    </div>
    <%= render "shared/cookie_banner" %>
  </body>
</html>
