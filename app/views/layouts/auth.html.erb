<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full bg-gray-50">
  <head>
    <%= render "shared/seo" %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full text-gray-950 antialiased">
    <div class="relative flex min-h-full flex-col overflow-hidden">
      <%# Soft brand glow behind the card, in line with the demo's gradient accents. %>
      <div aria-hidden="true" class="pointer-events-none absolute -top-40 left-1/2 h-[36rem] w-[72rem] -translate-x-1/2 rounded-full bg-brand-gradient opacity-20 blur-3xl"></div>

      <div class="absolute right-4 top-4 z-10 sm:right-6 sm:top-6">
        <%= render "shared/locale_switcher" %>
      </div>

      <main class="relative flex flex-1 flex-col justify-center px-4 py-12 sm:px-6 lg:px-8">
        <div class="mx-auto w-full max-w-md">
          <%= render "shared/flash" %>
        </div>
        <%= yield %>
      </main>

      <footer class="relative mx-auto flex w-full max-w-5xl flex-col items-center gap-y-3 px-6 pb-8 text-xs text-gray-400 sm:flex-row sm:items-end sm:justify-between">
        <div class="space-y-1 text-center sm:text-left">
          <p>GrowCentric.ai · <%= dt("The growth brain for your eCommerce store") %></p>
          <p>&copy; <%= Date.current.year %> <a href="https://keferboeck.com" target="_blank" rel="noopener" class="font-medium text-gray-500 transition hover:text-accent-600">Keferboeck Ltd</a>. <%= dt("All rights reserved.") %></p>
        </div>
        <div class="flex items-center gap-x-2">
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          <a href="https://www.linkedin.com/company/growcentrics/" target="_blank" rel="noopener" aria-label="GrowCentric.ai on LinkedIn" class="font-medium text-gray-500 transition hover:text-accent-600">GrowCentric</a>
        </div>
      </footer>
    </div>
  </body>
</html>
