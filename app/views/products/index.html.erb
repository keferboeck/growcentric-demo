<% content_for :title, dt("Hidden potential") %>

<%= render "shared/page_header",
    title: dt("Hidden potential"),
    subtitle: dt("Products and brands with real commercial potential that nobody is actively pushing. Ranked by the potential signal from your catalog, demand trends and competitive position."),
    action_label: dt("Re-run analysis") %>

<%= render "shared/product_filters", count: @products.size %>

<dl class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
  <%= render "shared/stat_tile", label: dt("Hidden gems found"), value: @hidden_gems.size,
      note: dt("of %{count} products analyzed", count: @products.size) %>
  <%= render "shared/stat_tile", label: dt("Revenue in hidden gems"), value: "#{euro_compact(@untapped_cents)}/mo",
      note: dt("with almost no ad spend behind it") %>
  <%= render "shared/stat_tile", label: dt("Average potential score"), value: @avg_potential,
      note: dt("average across this selection is %{avg}", avg: @catalog_avg) %>
</dl>

<div class="mt-6 grid grid-cols-1 gap-4 xl:grid-cols-3">
  <% @rollups.each do |title, rows| %>
    <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-gray-950/5">
      <h2 class="text-sm font-semibold"><%= dt(title) %></h2>
      <ul role="list" class="mt-3 space-y-2.5">
        <% rows.each do |row| %>
          <li>
            <div class="flex items-baseline justify-between gap-x-2 text-sm">
              <p class="truncate font-medium"><%= dt(row[:name]) %></p>
              <p class="shrink-0 tabular-nums text-gray-500"><%= euro_compact(row[:revenue]) %>/mo</p>
            </div>
            <div class="mt-1 flex items-center gap-x-2">
              <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-gray-100">
                <div class="h-full rounded-full bg-accent-400" style="width: <%= row[:share].round(1) %>%"></div>
              </div>
              <span class="w-10 shrink-0 text-right text-xs tabular-nums text-gray-400"><%= number_with_precision(row[:share], precision: 0) %>%</span>
            </div>
            <p class="mt-0.5 text-xs text-gray-400">
              <%= row[:count] == 1 ? dt("1 product") : dt("%{count} products", count: row[:count]) %> · <%= dt("potential Ø %{p}", p: row[:potential]) %><%= " · #{row[:gems] == 1 ? dt("1 hidden gem") : dt("%{count} hidden gems", count: row[:gems])}" if row[:gems].positive? %>
            </p>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>

<div class="mt-6 overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-gray-950/5">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead>
        <tr class="text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
          <th scope="col" class="py-3.5 pl-6 pr-3"><%= dt("Product") %></th>
          <th scope="col" class="px-3 py-3.5"><%= dt("Category") %></th>
          <th scope="col" class="px-3 py-3.5 text-right"><%= dt("Price") %></th>
          <th scope="col" class="px-3 py-3.5"><%= dt("Potential") %></th>
          <th scope="col" class="px-3 py-3.5 text-right"><%= dt("Revenue / mo") %></th>
          <th scope="col" class="px-3 py-3.5 text-right"><%= dt("Ad spend / mo") %></th>
          <th scope="col" class="px-3 py-3.5 text-right"><%= dt("Trend") %></th>
          <th scope="col" class="py-3.5 pl-3 pr-6"><%= dt("Status") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @products.each do |product| %>
          <tr class="<%= 'bg-accent-50/40' if product.status == 'hidden_gem' %>">
            <td class="py-4 pl-6 pr-3">
              <p class="font-medium text-gray-950"><%= product.name %></p>
              <p class="mt-0.5 text-xs text-gray-400"><%= product.brand.name %> · <%= product.sku %></p>
            </td>
            <td class="px-3 py-4">
              <p class="text-gray-500"><%= dt(product.category.name) %></p>
              <p class="mt-0.5 text-xs text-gray-400"><%= dt(product.department.name) %> · <%= dt(product.price_tier) %> · <%= dt(product.season_label) %></p>
            </td>
            <td class="px-3 py-4 text-right tabular-nums text-gray-500"><%= euro(product.price_cents, precision: 2) %></td>
            <td class="px-3 py-4">
              <div class="flex items-center gap-x-2">
                <div class="h-1.5 w-20 overflow-hidden rounded-full bg-accent-100">
                  <div class="h-full rounded-full bg-accent-400" style="width: <%= product.potential_score %>%"></div>
                </div>
                <span class="w-6 text-right text-xs font-semibold tabular-nums text-gray-950"><%= product.potential_score %></span>
              </div>
            </td>
            <td class="px-3 py-4 text-right tabular-nums text-gray-500"><%= euro(product.monthly_revenue_cents) %></td>
            <td class="px-3 py-4 text-right tabular-nums text-gray-500"><%= euro(product.monthly_ad_spend_cents) %></td>
            <td class="px-3 py-4 text-right text-xs"><%= trend_text(product.trend_pct) %></td>
            <td class="py-4 pl-3 pr-6"><%= status_badge(product.status) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
