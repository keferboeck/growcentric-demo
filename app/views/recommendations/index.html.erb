<% content_for :title, dt("Recommendations") %>

<%= render "shared/page_header",
    title: dt("Recommendations"),
    subtitle: dt("Where to invest next, where to pull back, and what to correct before it shows up in your P&L. Every suggestion is backed by a competitive or forecast signal."),
    action_label: dt("Apply all safe actions") %>

<div class="mt-8 rounded-2xl p-px bg-brand-gradient shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-4 rounded-[calc(1rem-1px)] bg-white px-6 py-5">
    <div>
      <p class="text-sm text-gray-500"><%= dt("Projected impact if all recommendations are applied") %></p>
      <p class="mt-1 text-3xl font-semibold tracking-tight">+<%= euro_compact(@total_impact_cents) %><span class="text-lg font-medium text-gray-400"> / <%= dt("month") %></span></p>
    </div>
    <p class="max-w-md text-sm leading-6 text-gray-500"><%= dt("Estimates combine freed ad budget, captured demand on under-promoted products and avoided decline on losing SKUs.") %></p>
  </div>
</div>

<%
  sections = [
    ["invest",     dt("Invest"),           dt("Budget that should move toward under-promoted winners."),            "bg-emerald-50 text-emerald-700 ring-emerald-600/20"],
    ["pull_back",  dt("Pull back"),        dt("Spend running against offers you have already lost on."),             "bg-rose-50 text-rose-700 ring-rose-600/20"],
    ["corrective", dt("Corrective"),       dt("Forecast-driven actions to stop a decline before it materializes."),  "bg-accent-50 text-accent-700 ring-accent-600/20"],
    ["attention",  dt("Needs attention"),  dt("Not yet critical, but a decision is needed soon."),                      "bg-amber-50 text-amber-700 ring-amber-600/20"]
  ]
%>

<div class="mt-6 space-y-8">
  <% sections.each do |kind, heading, description, badge_css| %>
    <% next unless @grouped[kind] %>
    <section>
      <div class="flex items-baseline gap-x-3">
        <h2 class="text-base font-semibold"><%= heading %></h2>
        <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium ring-1 ring-inset <%= badge_css %>"><%= @grouped[kind].size %></span>
        <p class="hidden text-sm text-gray-400 sm:block"><%= description %></p>
      </div>
      <ul role="list" class="mt-3 space-y-3">
        <% @grouped[kind].each do |rec| %>
          <li class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-gray-950/5">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="min-w-0 max-w-2xl">
                <p class="text-sm font-semibold"><%= dt(rec.title) %></p>
                <p class="mt-1 text-sm leading-6 text-gray-500"><%= dt(rec.body) %></p>
                <p class="mt-2 text-xs text-gray-400"><%= dt("Target:") %> <%= dt(rec.target) %></p>
              </div>
              <div class="flex shrink-0 flex-col items-end gap-y-2">
                <p class="text-sm font-semibold text-emerald-600">+<%= euro_compact(rec.impact_cents) %>/mo</p>
                <div class="flex items-center gap-x-2">
                  <div class="h-1.5 w-16 overflow-hidden rounded-full bg-gray-100">
                    <div class="h-full rounded-full bg-accent-400" style="width: <%= rec.confidence %>%"></div>
                  </div>
                  <span class="text-xs tabular-nums text-gray-400"><%= rec.confidence %>%</span>
                </div>
                <div class="mt-1 flex gap-x-2">
                  <button type="button" class="rounded-full bg-gray-950 px-3 py-1.5 text-xs font-semibold text-white hover:bg-gray-800"><%= dt("Apply") %></button>
                  <button type="button" class="rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50"><%= dt("Dismiss") %></button>
                </div>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
