<div class="space-y-6">
  <div class="rounded-2xl bg-white shadow-sm ring-1 ring-gray-950/5">
    <div class="border-b border-gray-100 px-6 py-4">
      <h2 class="text-base font-semibold"><%= dt("Connected services") %></h2>
      <p class="mt-0.5 text-sm text-gray-500"><%= dt("Where GrowCentric reads from and writes to.") %></p>
    </div>
    <ul role="list" class="divide-y divide-gray-100">
      <% [
        ["Solidus", "velora.keferboeck.com · v4.4", true, dt("Orders, catalog, prices. Write access for repricing.")],
        ["Google Ads", dt("Account 493-221-0158 · budgets & performance"), true, dt("Campaign budgets are adjusted via the official API.")],
        ["Google Merchant Center", dt("Feed synced 38 minutes ago"), true, dt("Prices flow to Shopping within minutes of a change.")],
        ["Meta Ads", dt("Ad account Velora · catalog connected"), true, dt("Adset budgets and dynamic product ads.")],
        ["TikTok Ads", dt("Test account · Orbit UGC campaign"), true, dt("Budget control for the running test.")],
        ["Slack", "#velora-growth", true, dt("Briefings, alerts and approvals in your channel.")],
        ["Apify", dt("SERP data source · EU entity (Prague)"), true, dt("Google Shopping discovery. Swappable provider by design.")]
      ].each do |name, detail, connected, note| %>
        <li class="flex items-center justify-between gap-x-6 px-6 py-4">
          <div class="min-w-0">
            <div class="flex items-center gap-x-2">
              <p class="text-sm font-semibold"><%= name %></p>
              <span class="inline-flex items-center gap-x-1 rounded-md bg-emerald-50 px-1.5 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">
                <span class="h-1 w-1 rounded-full bg-emerald-500"></span><%= dt("Connected") %>
              </span>
            </div>
            <p class="mt-0.5 truncate text-xs text-gray-400"><%= detail %></p>
            <p class="mt-0.5 text-sm text-gray-500"><%= note %></p>
          </div>
          <button type="button" class="shrink-0 rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50"><%= dt("Manage") %></button>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="rounded-2xl bg-white shadow-sm ring-1 ring-gray-950/5">
    <div class="border-b border-gray-100 px-6 py-4">
      <h2 class="text-base font-semibold"><%= dt("Your crawler") %></h2>
      <p class="mt-0.5 text-sm text-gray-500"><%= dt("Runs on your infrastructure with our technology. GrowCentric never crawls competitors centrally.") %></p>
    </div>
    <div class="divide-y divide-gray-100 px-6">
      <div class="flex items-center justify-between gap-x-6 py-4">
        <div>
          <p class="text-sm font-semibold"><%= dt("Crawl cadence") %></p>
          <p class="mt-0.5 text-sm text-gray-500"><%= dt("How often competitor sites are visited. Higher cadence, fresher indices, more load on your infrastructure.") %></p>
        </div>
        <select class="rounded-lg border-0 bg-gray-50 py-1.5 pl-3 pr-8 text-sm font-semibold ring-1 ring-inset ring-gray-200 focus:ring-2 focus:ring-accent-400">
          <option><%= dt("Every hour") %></option>
          <option selected><%= dt("Every 6 hours") %></option>
          <option><%= dt("Daily") %></option>
        </select>
      </div>
      <%= render "settings/toggle_row", on: true,
          label: dt("Respect robots.txt"),
          description: dt("Always on. This switch exists so you can see it is always on.") %>
      <div class="py-4">
        <div class="flex items-start gap-x-3 rounded-xl border border-emerald-200 bg-emerald-50/60 px-4 py-3">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
          <p class="text-sm leading-6 text-emerald-800"><span class="font-semibold text-emerald-900"><%= dt("GDPR by architecture.") %></span> <%= dt("Raw competitor prices are processed in memory and discarded. Only derived indices (your price relative to the market) are stored. There is no competitor price database that could become a liability.") %></p>
        </div>
      </div>
      <div class="flex items-center justify-between gap-x-6 py-4">
        <div>
          <p class="text-sm font-semibold"><%= dt("Crawl credits") %></p>
          <p class="mt-0.5 text-sm text-gray-500"><%= dt("738 of 1.000 plan credits used this month, 250 top-up credits in reserve.") %></p>
        </div>
        <%= link_to dt("Buy crawl credits →"), settings_section_path("billing"), class: "shrink-0 text-sm font-semibold text-accent-600 hover:text-accent-700" %>
      </div>
      <div class="flex items-center justify-between gap-x-6 py-4">
        <div>
          <p class="text-sm font-semibold"><%= dt("Index retention") %></p>
          <p class="mt-0.5 text-sm text-gray-500"><%= dt("How long derived indices are kept for trend analysis.") %></p>
        </div>
        <select class="rounded-lg border-0 bg-gray-50 py-1.5 pl-3 pr-8 text-sm font-semibold ring-1 ring-inset ring-gray-200 focus:ring-2 focus:ring-accent-400">
          <option><%= dt("6 months") %></option>
          <option selected><%= dt("12 months") %></option>
          <option><%= dt("24 months") %></option>
        </select>
      </div>
    </div>
  </div>
</div>
