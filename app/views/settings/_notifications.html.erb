<div class="space-y-6">
  <div class="rounded-2xl bg-white shadow-sm ring-1 ring-gray-950/5">
    <div class="border-b border-gray-100 px-6 py-4">
      <h2 class="text-base font-semibold"><%= dt("Morning briefing") %></h2>
      <p class="mt-0.5 text-sm text-gray-500"><%= dt("Sherpa's daily summary of what moved overnight and what waits for your approval.") %></p>
    </div>
    <div class="divide-y divide-gray-100 px-6">
      <%= render "settings/toggle_row", on: true,
          label: dt("Send the briefing every morning"),
          description: dt("Delivered at 07:00 to your inbox and #velora-growth on Slack.") %>
      <%= render "settings/toggle_row", on: true,
          label: dt("Include competitor movement"),
          description: dt("Price moves, new offers, sale starts and shipping changes above your relevance threshold.") %>
      <%= render "settings/toggle_row", on: true,
          label: dt("Include staged auto-reactions"),
          description: dt("When Sherpa prepares a reaction to a competitor move, it appears in the briefing with a one-click approval.") %>
      <div class="flex items-center justify-between gap-x-6 py-4">
        <div>
          <p class="text-sm font-semibold"><%= dt("Delivery time") %></p>
          <p class="mt-0.5 text-sm text-gray-500"><%= dt("Timezone: Europe/Vienna") %></p>
        </div>
        <input type="time" value="07:00" class="rounded-lg border-0 bg-gray-50 px-3 py-1.5 text-sm font-semibold ring-1 ring-inset ring-gray-200 focus:ring-2 focus:ring-accent-400">
      </div>
    </div>
  </div>

  <div class="rounded-2xl bg-white shadow-sm ring-1 ring-gray-950/5">
    <div class="border-b border-gray-100 px-6 py-4">
      <h2 class="text-base font-semibold"><%= dt("Alerts") %></h2>
      <p class="mt-0.5 text-sm text-gray-500"><%= dt("Immediate notifications outside the briefing rhythm.") %></p>
    </div>
    <div class="divide-y divide-gray-100 px-6">
      <%= render "settings/toggle_row", on: true,
          label: dt("Critical alerts, immediately"),
          description: dt("New sponsored competitor on core queries, price war signals, crawler failures. Email and Slack.") %>
      <%= render "settings/toggle_row", on: true,
          label: dt("Early warnings from the forecast"),
          description: dt("When a category is projected to fall below plan. High bar by design: a bad week is noise, a trend is a warning.") %>
      <%= render "settings/toggle_row", on: false,
          label: dt("Every auto-applied change"),
          description: dt("One notification per repricing or budget move. Loud; most teams rely on the briefing digest instead.") %>
    </div>
    <div class="flex justify-end border-t border-gray-100 px-6 py-4">
      <button type="button" class="rounded-full bg-gray-950 px-4 py-2 text-sm font-semibold text-white hover:bg-gray-800"><%= dt("Save changes") %></button>
    </div>
  </div>
</div>
