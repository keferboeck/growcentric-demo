<div class="space-y-6">
  <div class="rounded-2xl bg-white shadow-sm ring-1 ring-gray-950/5">
    <div class="border-b border-gray-100 px-6 py-4">
      <h2 class="text-base font-semibold"><%= dt("Your profile") %></h2>
    </div>
    <div class="space-y-5 px-6 py-5">
      <div class="flex items-center gap-x-4">
        <div class="flex h-16 w-16 items-center justify-center rounded-full bg-gray-950 text-lg font-semibold text-white">GK</div>
        <button type="button" class="rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50"><%= dt("Change photo") %></button>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label class="text-sm font-semibold"><%= dt("Full name") %></label>
          <input type="text" value="Georg Keferböck" class="mt-1.5 w-full rounded-lg border-0 bg-gray-50 px-3 py-2 text-sm ring-1 ring-inset ring-gray-200 focus:ring-2 focus:ring-accent-400">
        </div>
        <div>
          <label class="text-sm font-semibold"><%= dt("Email") %></label>
          <input type="email" value="georg@keferboeck.com" class="mt-1.5 w-full rounded-lg border-0 bg-gray-50 px-3 py-2 text-sm ring-1 ring-inset ring-gray-200 focus:ring-2 focus:ring-accent-400">
        </div>
        <div>
          <label class="text-sm font-semibold"><%= dt("Language") %></label>
          <select class="mt-1.5 w-full rounded-lg border-0 bg-gray-50 px-3 py-2 text-sm ring-1 ring-inset ring-gray-200 focus:ring-2 focus:ring-accent-400">
            <option <%= "selected" if I18n.locale == :en %>>English</option>
            <option <%= "selected" if I18n.locale == :de %>>Deutsch</option>
          </select>
        </div>
        <div>
          <label class="text-sm font-semibold"><%= dt("Timezone") %></label>
          <select class="mt-1.5 w-full rounded-lg border-0 bg-gray-50 px-3 py-2 text-sm ring-1 ring-inset ring-gray-200 focus:ring-2 focus:ring-accent-400">
            <option selected>Europe/Vienna</option>
            <option>Europe/Berlin</option>
            <option>Europe/London</option>
          </select>
        </div>
      </div>
    </div>
    <div class="flex justify-end border-t border-gray-100 px-6 py-4">
      <button type="button" class="rounded-full bg-gray-950 px-4 py-2 text-sm font-semibold text-white hover:bg-gray-800"><%= dt("Save changes") %></button>
    </div>
  </div>

  <div class="rounded-2xl bg-white shadow-sm ring-1 ring-gray-950/5">
    <div class="border-b border-gray-100 px-6 py-4">
      <h2 class="text-base font-semibold"><%= dt("Security") %></h2>
    </div>
    <div class="divide-y divide-gray-100 px-6">
      <div class="flex items-center justify-between gap-x-6 py-4">
        <div>
          <p class="text-sm font-semibold"><%= dt("Password") %></p>
          <p class="mt-0.5 text-sm text-gray-500"><%= dt("Last changed 3 months ago") %></p>
        </div>
        <button type="button" class="rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50"><%= dt("Change password") %></button>
      </div>
      <%= render "settings/toggle_row", on: true,
          label: dt("Two-factor authentication"),
          description: dt("Required for approving price changes above €50 impact.") %>
      <div class="flex items-center justify-between gap-x-6 py-4">
        <div>
          <p class="text-sm font-semibold"><%= dt("Active sessions") %></p>
          <p class="mt-0.5 text-sm text-gray-500"><%= dt("2 devices · MacBook Pro (this device), iPhone") %></p>
        </div>
        <button type="button" class="text-sm font-medium text-gray-400 hover:text-rose-600"><%= dt("Sign out everywhere") %></button>
      </div>
    </div>
  </div>
</div>
