<div class="space-y-6">
  <div class="rounded-2xl bg-white shadow-sm ring-1 ring-gray-950/5">
    <div class="flex items-center justify-between border-b border-gray-100 px-6 py-4">
      <div>
        <h2 class="text-base font-semibold"><%= dt("Team") %></h2>
        <p class="mt-0.5 text-sm text-gray-500"><%= dt("Who can see, approve and configure. 3 of 5 seats used.") %></p>
      </div>
      <button type="button" class="rounded-full bg-gray-950 px-4 py-2 text-sm font-semibold text-white hover:bg-gray-800"><%= dt("Invite member") %></button>
    </div>
    <ul role="list" class="divide-y divide-gray-100">
      <% [
        ["Georg Keferböck", "georg@keferboeck.com", "GK", dt("Owner"), dt("Everything, including billing and team"), false],
        ["Lena Moser", "lena@velora.example", "LM", dt("Admin"), dt("Approves prices and budgets, edits thresholds"), true],
        ["Tobias Brandt", "tobias@velora.example", "TB", dt("Analyst"), dt("Sees everything, approves nothing"), true]
      ].each do |name, email, initials, role, scope, editable| %>
        <li class="flex items-center justify-between gap-x-6 px-6 py-4">
          <div class="flex min-w-0 items-center gap-x-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full <%= initials == 'GK' ? 'bg-gray-950 text-white' : 'bg-gray-100 text-gray-600' %> text-sm font-semibold"><%= initials %></div>
            <div class="min-w-0">
              <p class="truncate text-sm font-semibold"><%= name %></p>
              <p class="truncate text-xs text-gray-400"><%= email %></p>
              <p class="mt-0.5 text-xs text-gray-500"><%= scope %></p>
            </div>
          </div>
          <div class="flex shrink-0 items-center gap-x-3">
            <% if editable %>
              <select class="rounded-lg border-0 bg-gray-50 py-1.5 pl-3 pr-8 text-sm font-semibold ring-1 ring-inset ring-gray-200 focus:ring-2 focus:ring-accent-400">
                <option <%= "selected" if role == dt("Admin") %>><%= dt("Admin") %></option>
                <option <%= "selected" if role == dt("Analyst") %>><%= dt("Analyst") %></option>
                <option><%= dt("Viewer") %></option>
              </select>
              <button type="button" class="text-sm font-medium text-gray-400 hover:text-rose-600"><%= dt("Remove") %></button>
            <% else %>
              <span class="inline-flex items-center rounded-md bg-accent-50 px-2 py-1 text-xs font-medium text-accent-700 ring-1 ring-inset ring-accent-600/20"><%= role %></span>
            <% end %>
          </div>
        </li>
      <% end %>
      <li class="flex items-center justify-between gap-x-6 bg-gray-50/60 px-6 py-4">
        <div class="flex min-w-0 items-center gap-x-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 border-dashed border-gray-300 text-sm font-semibold text-gray-400">SB</div>
          <div class="min-w-0">
            <p class="truncate text-sm font-semibold text-gray-500">steuerberatung@kanzlei-wagner.example</p>
            <p class="mt-0.5 text-xs text-gray-400"><%= dt("Invited 2 days ago as Viewer · not yet accepted") %></p>
          </div>
        </div>
        <button type="button" class="shrink-0 text-sm font-medium text-accent-600 hover:text-accent-700"><%= dt("Resend invite") %></button>
      </li>
    </ul>
  </div>

  <div class="rounded-2xl bg-white shadow-sm ring-1 ring-gray-950/5">
    <div class="border-b border-gray-100 px-6 py-4">
      <h2 class="text-base font-semibold"><%= dt("Roles") %></h2>
    </div>
    <dl class="divide-y divide-gray-100 px-6 text-sm">
      <% [
        [dt("Owner"), dt("Full control: settings, billing, team, all approvals.")],
        [dt("Admin"), dt("Approves staged changes, edits automation thresholds. No billing, no team management.")],
        [dt("Analyst"), dt("Read access to every page and export. Cannot approve or configure.")],
        [dt("Viewer"), dt("Dashboard and reports only. Ideal for accountants and agencies.")]
      ].each do |role, description| %>
        <div class="flex gap-x-6 py-3.5">
          <dt class="w-24 shrink-0 font-semibold"><%= role %></dt>
          <dd class="text-gray-500"><%= description %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</div>
