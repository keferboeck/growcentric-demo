<div class="flex items-start justify-between gap-x-6 py-4">
  <div class="min-w-0">
    <p class="text-sm font-semibold"><%= label %></p>
    <p class="mt-0.5 text-sm leading-6 text-gray-500"><%= description %></p>
  </div>
  <button type="button" role="switch" aria-checked="<%= on %>" data-role="toggle-switch"
          class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors <%= on ? 'bg-accent-500' : 'bg-gray-200' %>">
    <span class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition <%= on ? 'translate-x-5' : 'translate-x-0' %>"></span>
  </button>
</div>
