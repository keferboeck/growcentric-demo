<div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-4">
  <nav class="lg:col-span-1">
    <ul role="list" class="space-y-1">
      <% sections.each do |key, label, icon| %>
        <li>
          <%= link_to settings_section_path(key),
              class: "group flex gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 #{@section == key ? 'bg-accent-50 text-accent-700' : 'text-gray-700 hover:bg-gray-50 hover:text-accent-700'}" do %>
            <svg class="h-6 w-6 shrink-0 <%= @section == key ? 'text-accent-600' : 'text-gray-400 group-hover:text-accent-600' %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="<%= icons.fetch(icon) %>" />
            </svg>
            <%= label %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>

  <div class="lg:col-span-3">
    <%= render "settings/#{@section}" %>
  </div>
</div>

<script>
  (function () {
    document.querySelectorAll('[data-role="toggle-switch"]').forEach(function (toggle) {
      if (toggle.dataset.bound) return;
      toggle.dataset.bound = "1";
      toggle.addEventListener("click", function () {
        var on = toggle.getAttribute("aria-checked") === "true";
        toggle.setAttribute("aria-checked", !on);
        toggle.classList.toggle("bg-accent-500", !on);
        toggle.classList.toggle("bg-gray-200", on);
        toggle.querySelector("span").classList.toggle("translate-x-5", !on);
        toggle.querySelector("span").classList.toggle("translate-x-0", on);
      });
    });
  })();
</script>
