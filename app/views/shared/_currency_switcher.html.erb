<%# Display-currency picker for localised screenshots, styled to sit next
    to the language toggle. Selecting a currency reloads the page with
    ?currency=XXX, which the controller stores in the session. %>
<div class="relative">
  <select onchange="const u = new URL(location); u.searchParams.set('currency', this.value); location = u"
          aria-label="<%= dt("Display currency") %>"
          class="appearance-none rounded-full bg-white/90 py-2 pl-3 pr-8 text-sm font-medium text-zinc-800 shadow-lg shadow-zinc-800/5 ring-1 ring-zinc-900/5 backdrop-blur transition hover:ring-zinc-900/10">
    <% DemoCurrency::CURRENCIES.each_key do |code| %>
      <option value="<%= code %>" <%= "selected" if code == current_currency %>><%= code %></option>
    <% end %>
  </select>
  <svg viewBox="0 0 8 6" aria-hidden="true" class="pointer-events-none absolute right-3 top-1/2 h-1.5 w-2 -translate-y-1/2 fill-zinc-500">
    <path d="M0 0l4 6 4-6z"/>
  </svg>
</div>
