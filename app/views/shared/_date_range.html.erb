<%
  today = Date.current
  presets = [
    [dt("Today"),          today..today],
    [dt("Last 7 days"),    (today - 6)..today],
    [dt("Last 30 days"),   (today - 29)..today],
    [dt("Last 90 days"),   (today - 89)..today],
    [dt("Year to date"),   today.beginning_of_year..today],
    [dt("Last 12 months"), (today - 364)..today]
  ]
  fmt = ->(range) do
    from, to = range.first, range.last
    if from == to
      l(to, format: "%-d %b %Y")
    elsif from.year == to.year
      "#{l(from, format: '%-d %b')} - #{l(to, format: '%-d %b %Y')}"
    else
      "#{l(from, format: '%-d %b %Y')} - #{l(to, format: '%-d %b %Y')}"
    end
  end
  compares = [
    [dt("No comparison"), "", "off"],
    [dt("Previous period"), dt("vs previous period"), "on"],
    [dt("Same period last year"), dt("vs same period last year"), "off"]
  ]
  default_label = dt("Last 30 days")
%>
<div id="date-range" class="relative hidden sm:block">
  <button type="button" data-role="toggle"
          class="flex items-center gap-x-2 rounded-full bg-gray-50 px-3 py-1.5 text-sm text-gray-600 ring-1 ring-inset ring-gray-200 hover:bg-gray-100">
    <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" /></svg>
    <span data-role="label" class="font-medium text-gray-950"><%= default_label %></span>
    <span data-role="sublabel" class="hidden text-xs text-gray-400 lg:inline"><%= dt("vs previous period") %></span>
    <svg class="h-4 w-4 text-gray-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
  </button>

  <div data-role="panel" class="absolute right-0 z-50 mt-2 hidden w-80 rounded-xl bg-white p-1.5 shadow-lg ring-1 ring-gray-950/5">
    <p class="px-2.5 pb-1 pt-2 text-xs font-semibold uppercase tracking-wide text-gray-400"><%= dt("Date range") %></p>
    <ul role="list">
      <% presets.each do |label, range| %>
        <li>
          <button type="button" data-role="preset" data-label="<%= label %>" data-dates="<%= fmt.call(range) %>"
                  class="flex w-full items-center justify-between rounded-lg px-2.5 py-2 text-left text-sm hover:bg-gray-50"
                  aria-pressed="<%= label == default_label %>">
            <span class="flex items-center gap-x-2">
              <svg data-role="check" class="h-4 w-4 <%= label == default_label ? 'text-accent-600' : 'invisible' %>" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>
              <span class="<%= label == default_label ? 'font-semibold' : 'font-medium' %>"><%= label %></span>
            </span>
            <span class="text-xs tabular-nums text-gray-400"><%= fmt.call(range) %></span>
          </button>
        </li>
      <% end %>
    </ul>

    <div class="mx-2.5 my-1.5 h-px bg-gray-100"></div>
    <p class="px-2.5 pb-1 text-xs font-semibold uppercase tracking-wide text-gray-400"><%= dt("Compare to") %></p>
    <ul role="list">
      <% compares.each do |label, sublabel, state| %>
        <li>
          <button type="button" data-role="compare" data-label="<%= label %>" data-sub="<%= sublabel %>"
                  class="flex w-full items-center gap-x-2 rounded-lg px-2.5 py-2 text-left text-sm hover:bg-gray-50"
                  aria-pressed="<%= state == 'on' %>">
            <svg data-role="check" class="h-4 w-4 <%= state == 'on' ? 'text-accent-600' : 'invisible' %>" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>
            <span class="<%= state == 'on' ? 'font-semibold' : 'font-medium' %>"><%= label %></span>
          </button>
        </li>
      <% end %>
    </ul>

    <div class="mx-2.5 my-1.5 h-px bg-gray-100"></div>
    <div class="px-2.5 pb-2.5 pt-1">
      <p class="text-xs font-semibold uppercase tracking-wide text-gray-400"><%= dt("Custom range") %></p>
      <div class="mt-2 flex items-center gap-x-2">
        <input type="date" data-role="from" value="<%= (today - 29).iso8601 %>"
               class="w-full rounded-lg border-0 bg-gray-50 px-2 py-1.5 text-xs text-gray-950 ring-1 ring-inset ring-gray-200 focus:ring-2 focus:ring-accent-400">
        <span class="text-xs text-gray-400"><%= dt("to") %></span>
        <input type="date" data-role="to" value="<%= today.iso8601 %>"
               class="w-full rounded-lg border-0 bg-gray-50 px-2 py-1.5 text-xs text-gray-950 ring-1 ring-inset ring-gray-200 focus:ring-2 focus:ring-accent-400">
        <button type="button" data-role="apply"
                class="shrink-0 rounded-full bg-gray-950 px-3 py-1.5 text-xs font-semibold text-white hover:bg-gray-800"><%= dt("Apply") %></button>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById("date-range");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "1";
    var toggle = root.querySelector('[data-role="toggle"]');
    var panel = root.querySelector('[data-role="panel"]');
    var label = root.querySelector('[data-role="label"]');
    var sublabel = root.querySelector('[data-role="sublabel"]');

    function close() { panel.classList.add("hidden"); }

    toggle.addEventListener("click", function (e) {
      e.stopPropagation();
      panel.classList.toggle("hidden");
    });
    document.addEventListener("click", function (e) {
      if (!root.contains(e.target)) close();
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") close();
    });

    function select(group, button) {
      root.querySelectorAll('[data-role="' + group + '"]').forEach(function (b) {
        var on = b === button;
        b.setAttribute("aria-pressed", on);
        b.querySelector('[data-role="check"]').classList.toggle("invisible", !on);
        var text = b.querySelector('[data-role="check"]').nextElementSibling || b.querySelectorAll("span")[1];
        if (text) {
          text.classList.toggle("font-semibold", on);
          text.classList.toggle("font-medium", !on);
        }
      });
    }

    root.querySelectorAll('[data-role="preset"]').forEach(function (b) {
      b.addEventListener("click", function () {
        select("preset", b);
        label.textContent = b.dataset.label;
        toggle.title = b.dataset.dates;
        close();
      });
    });

    root.querySelectorAll('[data-role="compare"]').forEach(function (b) {
      b.addEventListener("click", function () {
        select("compare", b);
        sublabel.textContent = b.dataset.sub;
      });
    });

    root.querySelector('[data-role="apply"]').addEventListener("click", function () {
      var from = root.querySelector('[data-role="from"]').value;
      var to = root.querySelector('[data-role="to"]').value;
      if (!from || !to) return;
      var lang = document.documentElement.lang || "en-GB";
      var f = new Date(from), t = new Date(to);
      label.textContent = f.toLocaleDateString(lang, { day: "numeric", month: "short" }) + " - " + t.toLocaleDateString(lang, { day: "numeric", month: "short", year: "numeric" });
      root.querySelectorAll('[data-role="preset"] [data-role="check"]').forEach(function (c) { c.classList.add("invisible"); });
      close();
    });
  })();
</script>
