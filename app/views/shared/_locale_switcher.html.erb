<%# Language toggle in the keferboeck.com style: one circular button showing the
    current language's flag; clicking switches straight to the other language. %>
<%
  target = I18n.locale == :de ? "en" : "de"
  toggle_url = "#{request.path}?#{request.query_parameters.merge('locale' => target).to_query}"
%>
<a href="<%= toggle_url %>"
   aria-label="<%= I18n.locale == :de ? "Switch to English" : "Auf Deutsch wechseln" %>"
   title="<%= I18n.locale == :de ? "Switch to English" : "Auf Deutsch wechseln" %>"
   class="group rounded-full bg-white/90 px-3 py-2 shadow-lg shadow-zinc-800/5 ring-1 ring-zinc-900/5 backdrop-blur transition hover:ring-zinc-900/10">
  <%= render "shared/flag", country: I18n.locale == :de ? :de : :uk, css: "h-6 w-6", suffix: "-nav" %>
</a>
