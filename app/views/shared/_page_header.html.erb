<div class="md:flex md:items-center md:justify-between">
  <div class="min-w-0 flex-1">
    <h1 class="text-2xl font-semibold tracking-tight text-gray-950 sm:text-3xl"><%= title %></h1>
    <% if defined?(subtitle) && subtitle %>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-gray-500"><%= subtitle %></p>
    <% end %>
  </div>
  <% if defined?(action_label) && action_label %>
    <div class="mt-4 flex md:ml-4 md:mt-0">
      <button type="button" class="inline-flex items-center rounded-full bg-gray-950 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-gray-800"><%= action_label %></button>
    </div>
  <% end %>
</div>
