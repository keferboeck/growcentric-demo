<div id="shop-status" class="relative hidden md:block">
  <button type="button" data-role="toggle"
          class="flex items-center gap-x-2 rounded-full bg-gray-50 px-3 py-1.5 text-sm ring-1 ring-inset ring-gray-200 hover:bg-gray-100">
    <span class="relative flex h-2.5 w-2.5">
      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"></span>
      <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
    </span>
    <span class="font-medium text-gray-950">velora.keferboeck.com</span>
    <span class="hidden text-xs text-gray-400 xl:inline">Solidus · <%= dt("connected") %></span>
    <svg class="h-4 w-4 text-gray-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
  </button>

  <div data-role="panel" class="absolute left-0 z-50 mt-2 hidden w-96 rounded-xl bg-white p-1.5 shadow-lg ring-1 ring-gray-950/5">
    <div class="flex items-center justify-between px-3 pb-2 pt-2.5">
      <div>
        <p class="text-sm font-semibold">Velora Cycling Supply</p>
        <p class="text-xs text-gray-400">https://velora.keferboeck.com · Solidus 4.4</p>
      </div>
      <span class="inline-flex items-center gap-x-1.5 rounded-md bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span><%= dt("Connected") %>
      </span>
    </div>
    <div class="mx-3 h-px bg-gray-100"></div>
    <dl class="px-3 py-2 text-sm">
      <% [
        [dt("API health"), dt("Healthy · 142 ms average response"), :ok],
        [dt("Last sync"), dt("14 minutes ago · 132 orders, 16 products"), :ok],
        [dt("Price push"), dt("Live · last push 26 minutes ago via Solidus API"), :ok],
        [dt("Webhooks"), dt("Active · order/create, product/update, stock/change"), :ok],
        [dt("Your crawler"), dt("Healthy · next competitor run in 46 minutes"), :ok],
        [dt("Feed sync"), dt("Merchant Center 38 min ago · Meta catalog 41 min ago"), :ok]
      ].each do |label, detail, _state| %>
        <div class="flex items-start justify-between gap-x-4 py-1.5">
          <dt class="shrink-0 text-gray-500"><%= label %></dt>
          <dd class="flex items-center gap-x-1.5 text-right text-xs leading-5 text-gray-700">
            <%= detail %>
            <svg class="h-4 w-4 shrink-0 text-emerald-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" /></svg>
          </dd>
        </div>
      <% end %>
    </dl>
    <div class="mx-3 h-px bg-gray-100"></div>
    <div class="flex items-center justify-between px-3 py-2.5">
      <p class="text-xs text-gray-400"><%= dt("Uptime 99,98% · 30 days") %></p>
      <div class="flex gap-x-2">
        <button type="button" class="rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50"><%= dt("Sync now") %></button>
        <button type="button" class="rounded-full bg-gray-950 px-3 py-1.5 text-xs font-semibold text-white hover:bg-gray-800"><%= dt("Manage") %></button>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById("shop-status");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "1";
    var panel = root.querySelector('[data-role="panel"]');
    root.querySelector('[data-role="toggle"]').addEventListener("click", function (e) {
      e.stopPropagation();
      panel.classList.toggle("hidden");
    });
    document.addEventListener("click", function (e) {
      if (!root.contains(e.target)) panel.classList.add("hidden");
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") panel.classList.add("hidden");
    });
  })();
</script>
