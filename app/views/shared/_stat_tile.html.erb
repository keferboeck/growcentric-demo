<div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-gray-950/5">
  <div class="flex items-start justify-between gap-x-3">
    <div>
      <p class="text-sm leading-6 text-gray-500"><%= label %></p>
      <p class="mt-1 text-3xl font-semibold tracking-tight text-gray-950"><%= value %></p>
      <% if local_assigns[:delta] %>
        <p class="mt-1 text-xs">
          <span class="<%= local_assigns[:delta_positive] ? 'text-emerald-600' : 'text-rose-600' %> font-medium"><%= delta %></span>
          <span class="text-gray-400"> <%= local_assigns.fetch(:delta_label, dt("vs previous 30 days")) %></span>
        </p>
      <% elsif local_assigns[:note] %>
        <p class="mt-1 text-xs text-gray-400"><%= note %></p>
      <% end %>
    </div>
    <% if local_assigns[:spark] && spark.size > 1 %>
      <svg viewBox="0 0 96 36" class="mt-1 h-9 w-24 shrink-0 overflow-visible">
        <path d="<%= sparkline_path(spark, width: 96, height: 36) %>" fill="none" stroke="#d1d5db" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <%
          smin, smax = spark.minmax
          srange = [smax - smin, 1].max
          cy = 2 + (1 - (spark.last - smin).to_f / srange) * 32
        %>
        <circle cx="94" cy="<%= cy.round(1) %>" r="3.5" fill="#b060ff" stroke="#ffffff" stroke-width="2" />
      </svg>
    <% end %>
  </div>
</div>
