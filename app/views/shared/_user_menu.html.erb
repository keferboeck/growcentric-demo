<div id="user-menu" class="relative">
  <button type="button" data-role="toggle" class="flex items-center gap-x-3 rounded-full p-1 hover:bg-gray-50">
    <div class="flex h-8 w-8 items-center justify-center rounded-full bg-gray-950 text-xs font-semibold text-white">GK</div>
    <span class="hidden text-sm font-semibold lg:block">Georg</span>
    <svg class="hidden h-4 w-4 text-gray-400 lg:block" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
  </button>

  <div data-role="panel" class="absolute right-0 z-50 mt-2 hidden w-60 rounded-xl bg-white p-1.5 shadow-lg ring-1 ring-gray-950/5">
    <div class="px-2.5 pb-2 pt-2">
      <p class="text-sm font-semibold">Georg Keferböck</p>
      <p class="truncate text-xs text-gray-400">georg@keferboeck.com</p>
    </div>
    <div class="mx-2.5 mb-1 h-px bg-gray-100"></div>
    <%= link_to settings_section_path("profile"), class: "flex items-center gap-x-2.5 rounded-lg px-2.5 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-accent-700" do %>
      <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
      <%= dt("Your profile") %>
    <% end %>
    <%= link_to settings_section_path("billing"), class: "flex items-center gap-x-2.5 rounded-lg px-2.5 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-accent-700" do %>
      <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z" /></svg>
      <%= dt("Plan & billing") %>
    <% end %>
    <%= link_to settings_section_path("team"), class: "flex items-center gap-x-2.5 rounded-lg px-2.5 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-accent-700" do %>
      <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>
      <%= dt("Team & permissions") %>
    <% end %>
    <div class="mx-2.5 my-1 h-px bg-gray-100"></div>
    <%= link_to destroy_user_session_path, class: "flex w-full items-center gap-x-2.5 rounded-lg px-2.5 py-2 text-left text-sm font-medium text-gray-700 hover:bg-rose-50 hover:text-rose-700" do %>
      <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" /></svg>
      <%= dt("Sign out") %>
    <% end %>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById("user-menu");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "1";
    var panel = root.querySelector('[data-role="panel"]');
    root.querySelector('[data-role="toggle"]').addEventListener("click", function (e) {
      e.stopPropagation();
      panel.classList.toggle("hidden");
    });
    document.addEventListener("click", function (e) {
      if (!root.contains(e.target)) panel.classList.add("hidden");
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") panel.classList.add("hidden");
    });
  })();
</script>
